i sorunuyla mücadele eden Ekvadorlu kanat bek Jhoanner Chavez'in de takımda yer alması şüpheli.","Tecrübeli oyun kurucu Florian Thauvin, Şampiyonlar Ligi'nin ilk üç maç gününde (15) en fazla şansı yakalayan isim olurken, Como yıldızı Paz ise beş golün doğrudan sorumlusu oldu."],"tahmin":["Örneklem büyüklüğü küçük olmasına rağmen Como, Şampiyonlar Ligi maçlarının üçünde de ilk yarıda ilk golü atarak Avrupa'da hızlı bir başlangıç ​​yapma eğiliminde.","Lariani'ler aynı zamanda Lens'in dayanamayacağı bir güce sahip, bu nedenle dokuz noktaya kadar ilerleyecekler ve ev sahiplerini üç noktada mahsur bırakacaklar."]},"skor_tr":"Lens 1-2 Como"}],"sonuc":null,"kazanan":null,"notlar":[]}],"kuponlar":[{"butce":1,"kolon":1,"tutar":10,"sec":["1","2","1","1","1","1","2","2","1","1","1","2","2","1","1"],"p15":0.0001345253429842152,"p14":0.001885266231324784,"p13":0.012309662457168528,"p12":0.049947743604790075,"beklenen":8.5419,"dogru":0,"biten":0},{"butce":24,"kolon":24,"tutar":240,"sec":["012","2","01","1","1","1","2","2","1","1","12","2","2","01","1"],"p15":0.0018181946010607697,"p14":0.016974584411386294,"p13":0.07454781302364683,"p12":0.20658987992641786,"beklenen":10.064900000000003,"dogru":0,"biten":0},{"butce":96,"kolon":81,"tutar":810,"sec":["012","2","012","1","1","1","2","2","1","1","012","2","2","012","1"],"p15":0.004910053970456953,"p14":0.040053405411292826,"p13":0.1518608912202639,"p12":0.3602021373050795,"beklenen":10.9105,"dogru":0,"biten":0},{"butce":288,"kolon":243,"tutar":2430,"sec":["012","2","012","1","012","1","2","2","1","1","012","2","2","012","1"],"p15":0.010471430945738856,"p14":0.07355945508983726,"p13":0.24054908215408685,"p12":0.49572727612080175,"beklenen":11.4416,"dogru":0,"biten":0},{"butce":576,"kolon":486,"tutar":4860,"sec":["012","2","012","1","012","01","2","2","1","1","012","2","2","012","1"],"p15":0.016675076018568373,"p14":0.10459084543170671,"p13":0.3077452609774475,"p12":0.5781854173015454,"beklenen":11.734499999999999,"dogru":0,"biten":0},