i taşıyan oyuncular arasında Kamil Çörekci, Godfried Frimpong ve Mortadha Ben Ouanes'in de bulunduğu birçok potansiyel eksik oyuncusu var.","Ayberk Karapo'nun cezalı olduğu, Fousseni Diabate ve Kevin Mouanga'nın ise kadroda bulunup bulunmayacağı belirsiz."],"tahmin":["Rizespor'un son gelişmelerden sonra rekabetçi olması bekleniyor ancak Kasımpaşa'nın daha güçlü genel performansı ve seyahatlerindeki tutarlılığı, onları Cuma günkü karşılaşmaya giderken daha ikna edici bir taraf haline getiriyor.","Konuk ekip, her iki takımın da golü bulduğu, çekişmeli bir mücadeleye üstünlük sağlayabilir."]},"skor_tr":"Çaykur Rizespor 1-2 Kasımpaşa"}],"sonuc":null,"kazanan":null,"notlar":["Deplasman: 1 cezalı"]},{"no":3,"ev":"Samsunspor A.Ş.","dep":"Gençlerbirliği","lig":"SÜPL","ts":1795870800,"p":[0.5135,0.2843,0.2022],"piyasa":[0.4986,0.2648,0.2366],"halk":[65,19,16],"oran":{"bet365":{"o":[1.79,3.4,3.9],"open":[1.86,3.5,3.6]},"williamhill":{"o":[1.85,3.4,3.8],"open":[1.91,3.4,3.7]},"iddaa":{"o":[1.73,3.31,3.62]}},"eksik":{"h":[{"id":"OvozYVFt","n":"Cift Y. E.","r":"Inactive","onem":3},{"id":"Q7z76Mf5","n":"Kaya F.","r":"Inactive","onem":2},{"id":"djPEvQEb","n":"Yuksel C.","r":"Hamstring Injury","onem":8}],"a":[{"id":"fJUKQFbL","n":"Akkan G.","r":"Inactive","onem":0},{"id":"MymnWlv5","n":"Dursun A.","r":"Inactive","onem":6},{"id":"WWXEFAB3","n":"Goutas D.","r":"Injury","onem":9},{"id":"xnl3WgEP","n":"Rodrigues K.","r":"Muscle Injury","onem":0},{"id":"YZfIg7pm","n":"Thalisson","r":"Groin Injury","onem":8},{"id":"Awlr0pk9","n":"Cavusoglu E.","r":"Inactive","s":1,"onem":0},{"id":"GbdQwNvq","n":"Etebo P.","r":"Inactive","s":1,"onem":0}]},"bilgi":{"stad":"Samsun 19 Mayis Stadyumu","sehir":"Samsun"},"hava":{"t":14.6,"yagis":0.0,"yagis_ol":0,"ruzgar":2.1,"durum":"Kapalı"},"form":{"h":[{"t":1795266000,"ev":"Galatasaray","dep":"Samsunspor","s":"2:1","r":"l"},{"t":1794056400,"ev":"Samsunspor","dep":"Konyaspor","s":"1:0","r":"w"},{"t":1793538000,"ev":"Basaksehir","dep":"Samsunspor","s":"5:2","r":"l"},{"t":1792857600,"ev":"Samsunspor","dep":"Amedspor","s":"1:2","r":"l"},{"t":1792319400,"ev":"Kasimpasa","dep":"Samsunspor","s":"4:1","r":"l"}],"a":[{"t":1795257000,"ev":"Genclerbirligi","dep":"Gaziantep","s":"1:0","r":"w"},{"t":1794160800,"ev":"Besiktas","dep":"Genclerbirligi","s":"3:0","r":"l"},{"t":1793638800,"ev":"Genclerbirligi","dep":"Alanyaspor","s":"5:0","r":"w"},{"t":1793277000,"ev":"Genclerbirligi","dep":"Karakopru","s":"5:0","r":"w"},{"t":1792933200,"ev":"Konyaspor","dep":"Genclerbirligi","s":"2:0","r":"l"}],"h2h":[{"t":1768744800,"ev":"Genclerbirligi","dep":"Samsunspor","s":"1:1","r":""},{"t":1754755200,"ev":"Samsunspor","dep":"Genclerbirligi","s":"2:1","r":""},{"t":1679155200,"ev":"Genclerbirligi","dep":"Samsunspor","s":"0:1","r":""},{"t":1665244800,"ev":"Samsunspor","dep":"Genclerbirligi","s":"2:0","r":""},{"t":1644933600,"ev":"Genclerbirligi","dep":"Samsunspor","s":"2:2","r":""}]},"skor":[["1-1",0.1159],["1-0",0.1094],["2-1",0.0962],["2-0",0.0908],["0-1",0.0698]],"fs":"6HMshkS0","yorum":[{"kaynak":"Sports Mole","url":"https://www.sportsmole.co.uk/football/samsunspor/preview/samsunspor-vs-genclerbirligi-prediction-team-news-lineups_609943.html","yazar":"Joshua Cole","tarih":"2026-11-26T17:18:26+00:00","skor":"Samsunspor 2-1 Genclerbirligi","tr":{"onizleme":["Nenad Bjelica, Ekim ortasında Thorsten Fink'in yerine geçtiğinden bu yana beş maçta sadece bir galibiyet elde edebildi ve Samsunspor hiyerarşisinin umduğu etkiyi hemen sağlayamadı.","Hırvat'ın şimdiye kadarki tek galibiyeti, sondan bir önceki maçında kendi evinde Konyaspor'a karşı (1-0) geldi ve kendisinin yönetimindeki üç, kulübün ise sekiz yenilgilik serisine son verdi, ancak bu sonucun üzerine inşa edemediği için affedilebilir.","Kırmızı Şimşek, son molada şampiyon ve lig lideri Galatasaray'la karşılaşmak için sahaya çıktı ve 2-1 mağlup oldu; iki taraf arasındaki ciddi kalite farkı göz önüne alındığında, Bjelica'nın pek de umursamayacağı bir sonuçtu bu.","Ancak Samsun ekibi, 2011'den bu yana kaybetmediği ve geçen sezon bu sahada karşılaştığı son karşılaşmada 2-1 mağlup ettiği Gençlerbirliği karşısında yeniden yoluna girmeyi umuyor."],"kadro":["Samsunspor, diz sakatlığı nedeniyle iyileşme sürecinde olan Celil Yüksel'den yoksun olurken, Fatih Kaya ve Yunus Emre Çift de kadroda yer almayacak.","Emre Kılınç'ın Bjelica'ya vermesi gereken birkaç seçim kararı kalması şüpheli, ancak Mohamed Bayo'nun sezonun ilk golünü Galatasaray'a attıktan sonra yeniden liderliğe yükselmesi bekleniyor.","Gençlerbirliği'nde çok sayıda eksik oyuncu bulunurken, Dimitrios Goutas çapraz bağ sakatlığı nedeniyle bu sezon forma giyemeyecek.","Kevin Rodrigues'in de sakatlığı var, Peter Etebo, Gökhan Akkan ve Ensar Çavuşoğlu ise şüpheliler arasında."],"tahmin":["Samsunspor son haftalarda kötü bir mücadele veriyor ancak kendi sahasında Konyaspor karşısında aldıkları galibiyet, taraftarları önünde hala olumlu bir sonuç üretebileceklerini gösteriyor.","Konuk ekip genel olarak daha iyi bir sezon geçirdi ve Gaziantep'i mağlup ettikten sonra daha özgüvenli geldi ancak deplasman performansları önemli bir zayıflık olmaya devam ediyor."]},"skor_tr":"Samsunspor 2-1 Gençlerbirliği"}],"sonuc":null,"kazanan":null,"notlar":["Deplasman: 5 eksik oyuncu"]},{"no":4,"ev":"Gaziantep FK A.Ş.","dep":"Amed Sportif Faaliyetler","lig":"SÜPL","ts":1795881600,"p":[0.2444,0.2797,0.4759],"piyasa":[0.2737,0.2598,0.4665],"halk":[22,23,55],"oran":{"bet365":{"o":[3.4,3.5,1.9],"open":[3.4,3.6,1.9]},"williamhill":{"o":[3.3,3.5,2.0],"open":[3.3,3.5,2.0]},"iddaa":{"o":[3.12,3.34,1.86]}},"eksik":{"h":[{"id":"OCPOzOaA","n":"Bavuk F.","r":"Hamstring Injury","onem":1},{"id":"0laoe8QR","n":"Sangare N.","r":"Back Injury","onem":0},{"id":"pCRSfO3q","n":"Abena M.","r":"Injury","s":1,"onem":11}],"a":[{"id":"jyIenngh","n":"Demir D.","r":"Knee Injury","onem":0}]},"bilgi":{"stad":"Gaziantep Stadyumu","sehir":"Gaziantep"},"hava":{"t":10.2,"yagis":0.0,"yagis_ol":0,"ruzgar":6.3,"durum":"Kapalı"},"form":{"h":[{"t":1795257000,"ev":"Gencl